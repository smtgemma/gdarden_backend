PORT=7000
DB_URL="mongodb://127.0.0.1:27017/greetely"

NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES=10d
JWT_PASSWORD_RESET_SECRET=your_jwt_password_reset_secret_here

# BCRYPT
BCRYPT_SALT_ROUND=10

# SUPER ADMIN
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_password_here

# Express Session
EXPRESS_SESSION_SECRET=your_express_session_secret_here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
 
# AWS / S3
S3_ACCESS_KEY="your_s3_access_key_here"
S3_SECRET_KEY="your_s3_secret_key_here"
S3_REGION="us-east-1"
S3_BUCKET_NAME="your_s3_bucket_name_here"
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"

# SMTP Email
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_here
SMTP_FROM=noreply@example.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=""
REDIS_PASSWORD=""

# Frontend & Dashboard URLs
FRONTEND_LOCALHOST_URL=http://localhost:3041
FRONTEND_URL=http://localhost:3041
FRONTEND_DOMAIN_URL=https://greetely.com
DASHBOARD_LOCALHOST_URL=http://localhost:3010
DASHBOARD_URL=http://localhost:3010
DASHBOARD_DOMAIN_URL=https://dashboard.greetely.com

# AI URL
AI_BASE_URL=http://localhost:8005

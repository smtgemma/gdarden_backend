{
  "name": "gdarden",
  "version": "1.0.0",
  "description": "Gdarden Backend System",
  "main": "index.js",
  "scripts": {
    "start": "node ./dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "seed": "ts-node ./src/app/scripts/seed.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/app/utils/templates', 'dist/app/utils/templates', { recursive: true, force: true })\"",
    "lint": "eslint ./src --ext .ts",
    "test": "jest --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smtgemma/gdarden_backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "bugs": {
    "url": "https://github.com/smtgemma/gdarden_backend/issues"
  },
  "homepage": "https://github.com/smtgemma/gdarden_backend#readme",
  "overrides": {
    "proxy-addr": "^2.0.8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1003.0",
    "@aws-sdk/s3-request-presigner": "^3.1003.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.4",
    "multer": "^2.1.1",
    "multer-s3": "^3.0.1",
    "multer-storage-cloudinary": "^2.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.11",
    "openai": "^6.27.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
